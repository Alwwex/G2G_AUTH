# --- Přihlášení do webu ---
ADMIN_USER=admin
ADMIN_PASSWORD=zmen-me
# Volitelné: TOTP 2FA pro přihlášení do samotného webu (base32 secret). Prázdné = vypnuto.
# Vygeneruješ: npm run gen-secret
LOGIN_TOTP_SECRET=

# Tajný klíč pro šifrování uložených TOTP secretů a IMAP hesel (dlouhý náhodný řetězec!)
# Vygeneruješ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

PORT=3000
# Za HTTPS proxy (Caddy/nginx) nastav na 1 -> cookie budou Secure
TRUST_PROXY=0

# --- Výchozí IMAP účet (volitelné, další se dají přidat ve webu) ---
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=1
IMAP_USER=
IMAP_PASSWORD=
# Složky ke kopírování, oddělené čárkou
IMAP_FOLDERS=INBOX

# Jak často stahovat nové maily (sekundy)
SYNC_INTERVAL=60
