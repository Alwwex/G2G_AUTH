# --- Web app login ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Optional: TOTP 2FA for logging into the web app itself (base32 secret). Empty = disabled.
# Generate one with: npm run gen-secret
LOGIN_TOTP_SECRET=

# Key used to encrypt stored TOTP secrets and IMAP passwords (long random string!).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER change or lose it, otherwise stored secrets can't be decrypted.
APP_SECRET=

# --- Database ---
# Empty = local SQLite file in ./data (local / Docker / VPS).
# For Vercel / Render free etc. use a free Turso database:
#   DATABASE_URL=libsql://your-db-name.turso.io
#   DATABASE_AUTH_TOKEN=eyJ...
DATABASE_URL=
DATABASE_AUTH_TOKEN=

PORT=3000
# Set to 1 when running behind an HTTPS reverse proxy (Caddy/nginx/Render) -> Secure cookies
TRUST_PROXY=0

# Secret for the /api/cron sync endpoint (Vercel Cron sends it automatically,
# external pingers use https://your-site/api/cron?key=CRON_SECRET)
CRON_SECRET=

# --- Default IMAP mailbox (optional, more can be added in the web UI) ---
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=1
IMAP_USER=
IMAP_PASSWORD=
# Folders to copy, comma separated
IMAP_FOLDERS=INBOX

# How often to fetch new mail (seconds)
SYNC_INTERVAL=60
